model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder","GetFile","Suburbs","Quarters","Metro"]
annotation __PBI_TimeIntelligenceEnabled = 0

ref table Suburbs
ref table Quarters
ref table Metro

ref cultureInfo en-US
