table Suburbs
	lineageTag: 78368984-6814-5f0f-0156-58f4d5dfe55e

	/// The rise in the suburb's typical new-bond rent, 2015 to the year to June 2026 (blank with fewer than 40 bonds in either year)
	measure 'Rise (%)' = AVERAGE ( Suburbs[change_pct_all] )
		formatString: 0
		lineageTag: dcc3ace9-32eb-b950-90f6-8eb98d741055

	measure 'Rise, houses (%)' = AVERAGE ( Suburbs[change_pct_houses] )
		formatString: 0
		lineageTag: 0c7f75a2-36ce-59a6-0fe0-96551f0b811a

	measure 'Rise, units (%)' = AVERAGE ( Suburbs[change_pct_units] )
		formatString: 0
		lineageTag: 20870724-8ebd-a14e-ce2d-dc44fd2cba30

	measure 'Suburbs compared' = CALCULATE ( COUNTROWS ( Suburbs ), NOT ISBLANK ( Suburbs[change_pct_all] ) )
		formatString: #,0
		lineageTag: 260d7bf2-8755-0012-fe31-0b0ad2d5d571

	/// The middle suburb's rise, of the suburbs compared
	measure 'Median suburb rise (%)' = MEDIANX ( FILTER ( Suburbs, NOT ISBLANK ( Suburbs[change_pct_all] ) ), Suburbs[change_pct_all] )
		formatString: 0.0
		lineageTag: 8535c0af-522f-2ec6-2020-2e9f953a9144

