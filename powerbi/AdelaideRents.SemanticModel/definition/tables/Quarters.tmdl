table Quarters
	lineageTag: 5ecde7e2-25f7-4dcd-d7b5-5a349f16bb92

	/// The suburb's median weekly rent of new bonds in the quarter picked (the latest, June 2026, when none is)
	measure 'Median rent' =
			VAR q = MAX ( Quarters[quarter] )
			RETURN CALCULATE ( AVERAGE ( Quarters[rent] ), Quarters[quarter] = q )
		formatString: $#,0
		lineageTag: 174b28e0-83c2-8f8a-14ee-16259ed07c1d

	column code
		dataType: string
		lineageTag: e7ac9107-dcd5-ca56-61d4-76477f27d65b
		summarizeBy: none
		sourceColumn: code

		annotation SummarizationSetBy = Automatic

	column name
		dataType: string
		lineageTag: 88dcce5a-a169-0b88-c360-15e7db4eeb76
		summarizeBy: none
		sourceColumn: name

		annotation SummarizationSetBy = Automatic

	column quarter
		dataType: string
		lineageTag: 8f8847e4-c664-2300-1159-1a49a03cd79b
		summarizeBy: none
		sourceColumn: quarter

		annotation SummarizationSetBy = Automatic

	column rent
		dataType: double
		formatString: $#,0
		lineageTag: 685e1d05-a7f8-604f-9127-863fce9819da
		summarizeBy: none
		sourceColumn: rent

		annotation SummarizationSetBy = Automatic

	column bonds
		dataType: double
		formatString: #,0
		lineageTag: b7d8632a-019a-f330-cb67-434c7a587e96
		summarizeBy: none
		sourceColumn: bonds

		annotation SummarizationSetBy = Automatic

	column shown
		dataType: string
		lineageTag: 493ba2b4-f300-ed48-16d0-b385456cb015
		summarizeBy: none
		sourceColumn: shown

		annotation SummarizationSetBy = Automatic

	partition Quarters = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("tables/quarters.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"code", "name", "quarter", "rent", "bonds", "shown"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"code", type text}, {"name", type text}, {"quarter", type text}, {"rent", type number}, {"bonds", type number}, {"shown", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
